{
    "name": "telecomstock-pro",
    "version": "2.0.0",
    "description": "Logiciel de gestion de stock pour télécoms",
    "main": "electron/main.js",
    "scripts": {
        "start": "node backend/server.js",
        "dev": "node backend/server.js",
        "electron": "electron .",
        "build:exe": "electron-builder --win --x64",
        "build:exe:portable": "electron-builder --win portable"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "better-sqlite3": "^11.0.0",
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "express-rate-limit": "^7.0.0",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.0",
        "zod": "^3.22.0"
    },
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^26.15.3"
    },
    "build": {
        "appId": "com.telecomstock.pro",
        "productName": "TelecomStock Pro",
        "directories": {
            "output": "dist"
        },
        "win": {
            "target": ["nsis", "portable"],
            "icon": "build/icon.ico",
            "publisherName": "TelecomStock"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "TelecomStock Pro"
        },
        "portable": {
            "artifactName": "TelecomStock-Portable.exe"
        },
        "files": [
            "electron/**/*",
            "backend/**/*",
            "public/**/*",
            "package.json"
        ],
        "extraResources": [
            "data/**/*"
        ]
    }
}
