{
  "name": "telecomstock-pro",
  "version": "1.0.0",
  "description": "Logiciel de gestion de stock, ventes et crédits pour boutiques télécoms",
  "author": "SAWADOGO Ange Stephane <stephanesawdogo@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "npm run rebuild:node --silent && node backend/server.js",
    "serve": "npm run rebuild:node --silent && node backend/server.js",
    "electron": "electron .",
    "test": "npm run rebuild:node --silent && node tests/api.test.js && node tests/frontend.test.js",
    "test:api": "node tests/api.test.js",
    "test:front": "node tests/frontend.test.js",
    "rebuild:node": "node scripts/rebuild-native.js node",
    "rebuild:electron": "node scripts/rebuild-native.js electron",
    "build:exe": "electron-builder --win --x64 --config electron-builder.json",
    "build:apk": "node scripts/build-apk.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  }
}
