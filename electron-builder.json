{
  "appId": "com.telecomstock.pro",
  "productName": "TelecomStock Pro",
  "directories": {
    "output": "dist"
  },
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": "build/icon.ico",
    "publisherName": "TelecomStock"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "TelecomStock Pro"
  },
  "files": [
    "electron/**/*",
    "backend/**/*",
    "public/**/*",
    "package.json"
  ],
  "extraResources": [
    "data/**/*"
  ]
}
